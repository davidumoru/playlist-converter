---
import Layout from "../layouts/Layout.astro";
import Converter from "../components/Converter.svelte";
---

<Layout title="Crossfade - Move a playlist from YouTube to Spotify">
  <fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..620;1,9..144,300..620&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
      rel="stylesheet"
    />
  </fragment>
  <Converter client:load />
</Layout>
